<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#FFE8EAF6"
                android:startColor="#FFF3E8FF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#336750A4" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
</layer-list>
