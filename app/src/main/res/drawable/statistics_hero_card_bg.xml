<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/statistics_hero_end"
                android:startColor="@color/statistics_hero_start"
                android:type="linear" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
</layer-list>
