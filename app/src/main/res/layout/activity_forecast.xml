<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="@dimen/space_16"
    android:fitsSystemWindows="true">
    <include
        layout="@layout/include_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/forecastScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/forecastBudgetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/transaction_budget_label"
                app:icon="@drawable/ic_budget_expand"
                app:iconGravity="end"
                android:minHeight="@dimen/touch_min_size"
                app:cornerRadius="@dimen/radius_12" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forecast_horizon_label"
                style="@style/Text.MyBudget.SectionLabel" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastHorizonQuarter"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4"
                    android:text="@string/forecast_horizon_quarter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:minHeight="@dimen/touch_min_size"
                    app:cornerRadius="@dimen/radius_12" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastHorizonHalfYear"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4"
                    android:text="@string/forecast_horizon_half_year"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:minHeight="@dimen/touch_min_size"
                    app:cornerRadius="@dimen/radius_12" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastHorizonYear"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/forecast_horizon_year"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:minHeight="@dimen/touch_min_size"
                    app:cornerRadius="@dimen/radius_12" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/forecast_scenario_label"
                style="@style/Text.MyBudget.SectionLabel" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastScenarioOptimistic"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4"
                    android:text="@string/forecast_scenario_optimistic"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:minHeight="@dimen/touch_min_size"
                    app:cornerRadius="@dimen/radius_12" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastScenarioRealistic"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/forecast_scenario_realistic"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:minHeight="@dimen/touch_min_size"
                    app:cornerRadius="@dimen/radius_12" />
            </LinearLayout>
            <androidx.cardview.widget.CardView
                style="@style/Card.MyBudget.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.MyBudget.Subtitle"
                        android:text="@string/forecast_result_label" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.MyBudget.Title"
                        android:text="@string/analysis_value_pending"
                        android:id="@+id/forecastProjectedBalance"
                        android:textSize="28sp"
                        android:layout_marginVertical="@dimen/space_8" />
                    <TextView
                        android:id="@+id/forecastSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        style="@style/Text.MyBudget.Subtitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.MyBudget.Subtitle"
                        android:text="@string/forecast_result_note" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/forecastList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:id="@+id/forecastEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forecast_empty"
                android:visibility="gone"
                style="@style/Text.MyBudget.Subtitle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/forecastSaveSnapshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forecast_save_comparison"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:minHeight="@dimen/touch_min_size"
                app:cornerRadius="@dimen/radius_12" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/forecastVsFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/forecast_vs_fact_title"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:minHeight="@dimen/touch_min_size"
                app:cornerRadius="@dimen/radius_12" />
            <TextView
                android:id="@+id/forecastHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/forecast_subtitle"
                style="@style/Text.MyBudget.Subtitle" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
