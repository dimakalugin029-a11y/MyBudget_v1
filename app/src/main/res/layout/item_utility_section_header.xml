<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:layout_marginBottom="@dimen/space_4"
    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
    style="@style/Card.MyBudget.Surface.Small">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:id="@+id/sectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.MyBudget.Section"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/utilities_cyan"
            android:id="@+id/sectionTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.MyBudget.Amount"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
