<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:background="@color/background_light"
    android:paddingHorizontal="16dp" android:paddingTop="8dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/include_screen_header" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/incomePlanPreviousMonth" android:layout_width="48dp" android:layout_height="48dp"
            android:text="‹" android:textSize="28sp" android:textColor="@color/md_theme_primary" android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="@string/income_plan_previous_month"/>
        <TextView android:id="@+id/incomePlanMonth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_primary" android:textSize="16sp"/>
        <TextView android:id="@+id/incomePlanNextMonth" android:layout_width="48dp" android:layout_height="48dp"
            android:text="›" android:textSize="28sp" android:textColor="@color/md_theme_primary" android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="@string/income_plan_next_month"/>
    </LinearLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout android:id="@+id/incomePlanAppBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/background_light" app:elevation="0dp" app:liftOnScroll="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_scrollFlags="scroll|enterAlways">
                <include android:id="@+id/incomePlanHint" layout="@layout/include_dismissible_hint"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/screen_hero_card_bg_blue" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="12dp">
                    <TextView android:id="@+id/incomePlanSummaryTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/main_hero_text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/incomePlanSummaryProgress" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="@color/main_hero_text_primary" android:textSize="14sp"/>
                    <TextView android:id="@+id/incomePlanUnlinked" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textColor="@color/main_hero_text_secondary" android:textSize="13sp" android:visibility="gone"/>
                    <TextView android:id="@+id/incomePlanDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/income_plan_details"
                        android:textColor="@color/main_hero_text_primary" android:textSize="14sp" android:textStyle="bold"
                        android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
                </LinearLayout>
                <TextView android:id="@+id/incomePlanObligationsButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp" android:minHeight="48dp"
                    android:text="@string/income_plan_chip_obligations" style="@style/Chip.MyBudget.Filter"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/incomePlanRecycler"
                android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp"/>
            <TextView android:id="@+id/incomePlanEmptyState" android:gravity="center" android:padding="24dp" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/income_plan_empty" style="@style/Text.MyBudget.Subtitle"/>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
