<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_screen_header"/>
    <include
        android:id="@+id/incomePlanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_dismissible_hint"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/incomePlanPreviousMonth" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:contentDescription="Предыдущий месяц"/>
        <TextView android:id="@+id/incomePlanMonth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_primary" android:textSize="16sp"/>
        <Button android:id="@+id/incomePlanNextMonth" android:layout_width="48dp" android:layout_height="48dp" android:text="›" android:contentDescription="Следующий месяц"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/screen_hero_card_bg_blue"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_10">
            <TextView
                android:id="@+id/incomePlanSummaryTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/main_hero_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                style="@style/Text.MyBudget.Section"/>
            <TextView android:id="@+id/incomePlanSummaryProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/main_hero_text_primary" android:textSize="14sp"/>
            <TextView android:id="@+id/incomePlanSummaryAverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/main_hero_text_secondary" android:textSize="14sp"/>
            <TextView
                android:id="@+id/incomePlanSummaryBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/main_hero_text_secondary"
                style="@style/Text.MyBudget.Subtitle"/>
            <TextView
                android:id="@+id/incomePlanSummaryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/expense_red"
                android:visibility="gone"
                style="@style/Text.MyBudget.Subtitle"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/incomePlanObligationsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/income_plan_chip_obligations"
                style="@style/Chip.MyBudget.Filter"/>
        </LinearLayout>
    </HorizontalScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/incomePlanRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/incomePlanEmptyState"
            android:padding="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/income_plan_empty"
            style="@style/Text.MyBudget.Subtitle"/>
    </FrameLayout>
</LinearLayout>
