<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginStart="@dimen/space_16" android:layout_marginBottom="@dimen/space_6"
    android:background="@drawable/budget_leaf_row_bg" android:foreground="?attr/selectableItemBackground"
    android:padding="@dimen/space_12">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <View android:id="@+id/colorStrip" android:layout_width="4dp" android:layout_height="match_parent"
            android:minHeight="48dp" android:layout_marginEnd="@dimen/space_10" android:visibility="gone" />
        <LinearLayout android:id="@+id/leafMainArea" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/categoryName" style="@style/Text.MyBudget.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="16sp" />
            <TextView android:id="@+id/categoryBalance" style="@style/Text.MyBudget.Amount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:textSize="16sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/categoryMenuButton" android:layout_width="@dimen/touch_min_size" android:layout_height="@dimen/touch_min_size"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_nav_more"
            android:padding="@dimen/space_12" app:tint="@color/text_secondary" />
        <ImageButton android:id="@+id/dragHandle" android:layout_width="@dimen/touch_min_size" android:layout_height="@dimen/touch_min_size"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_drag_handle"
            android:contentDescription="@string/budget_drag_handle_desc" android:visibility="gone"
            android:padding="@dimen/space_12" app:tint="@color/text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/categoryPlanRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="@dimen/space_8" android:visibility="gone">
        <TextView android:id="@+id/categoryPlanText" style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_4" />
        <ProgressBar android:id="@+id/categoryPlanProgress" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:max="100"
            android:progressBackgroundTint="@color/border_light" />
    </LinearLayout>
    <LinearLayout android:id="@+id/categoryQuickActions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/addIncomeButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min_size"
            android:text="@string/main_primary_income" android:textColor="@color/income_green" app:icon="@drawable/ic_nav_add"
            app:iconTint="@color/income_green" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/addExpenseButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min_size"
            android:text="@string/main_primary_expense" android:textColor="@color/expense_red" app:icon="@drawable/ic_budget_minus"
            app:iconTint="@color/expense_red" app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
