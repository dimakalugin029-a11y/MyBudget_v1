<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/budget_child_indent"
    android:layout_marginEnd="@dimen/space_4"
    android:layout_marginBottom="@dimen/space_6"
    android:background="@drawable/budget_leaf_row_bg"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/space_10"
    android:paddingVertical="@dimen/space_8">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top">
        <View
            android:id="@+id/colorStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_gravity="fill_vertical"
            android:minHeight="36dp"
            android:layout_marginEnd="@dimen/space_8"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/leafMainArea"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top">
                <TextView
                    android:id="@+id/categoryName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="4"
                    android:textSize="15sp"
                    style="@style/Text.MyBudget.Section"/>
                <TextView
                    android:id="@+id/categoryBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:textSize="15sp"
                    style="@style/Text.MyBudget.Amount"/>
            </LinearLayout>
        </LinearLayout>
        <ImageButton
            android:id="@+id/addIncomeButton"
            android:layout_width="@dimen/touch_min_size"
            android:layout_height="@dimen/touch_min_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/budget_quick_income"
            android:padding="@dimen/space_6"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/income_green"/>
        <TextView
            android:id="@+id/addExpenseButton"
            android:layout_width="@dimen/touch_min_size"
            android:layout_height="@dimen/touch_min_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/budget_quick_expense"
            android:gravity="center"
            android:text="@string/ui_expense_minus"
            android:textColor="@color/expense_red"
            android:textSize="18sp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/categoryPlanRow"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/categoryPlanProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <TextView
            android:id="@+id/categoryPlanText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textSize="11sp"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
</LinearLayout>
