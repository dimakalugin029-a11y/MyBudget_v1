<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_20"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:text="@string/utility_new_month_message"
        style="@style/Text.MyBudget.Subtitle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/newMonthCreateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_6"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/utility_new_month_create"
        app:cornerRadius="@dimen/radius_10"
        style="@style/Widget.MaterialComponents.Button"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/newMonthCopyAmountsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_6"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/utility_copy_prev_with_amounts"
        app:cornerRadius="@dimen/radius_10"
        app:strokeColor="@color/budget_blue"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/newMonthCopyStructureButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/utility_copy_prev_structure"
        app:cornerRadius="@dimen/radius_10"
        app:strokeColor="@color/budget_blue"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
</LinearLayout>
