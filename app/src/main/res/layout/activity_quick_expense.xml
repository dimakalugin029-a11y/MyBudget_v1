<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickExpenseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_8">

    <include
        layout="@layout/include_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/transaction_hero_card_bg_expense"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/expense_amount_label"
                android:textAllCaps="true"
                android:textColor="@color/transaction_hero_expense_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/quickExpenseAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/transaction_hero_amount_field"
                android:hint="@string/expense_amount_hint"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:padding="@dimen/space_12"
                android:textColor="@color/transaction_hero_text_primary"
                android:textColorHint="@color/transaction_hero_text_hint"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        style="@style/Text.MyBudget.SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/quick_expense_category_label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quickExpenseCategoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/space_4" />
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickExpenseRepeatButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/quick_expense_repeat"
        android:visibility="gone"
        app:cornerRadius="@dimen/radius_10"
        app:strokeColor="@color/expense_red" />

    <TextView
        android:id="@+id/quickExpenseFullFormLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_16"
        android:padding="@dimen/space_8"
        android:text="@string/quick_expense_full_form"
        android:textColor="@color/expense_red"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickExpenseSaveButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/quick_expense_save"
        app:backgroundTint="@color/expense_red"
        app:cornerRadius="@dimen/radius_10" />
</LinearLayout>
