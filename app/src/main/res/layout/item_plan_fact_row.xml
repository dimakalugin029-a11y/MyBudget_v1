<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_6"
    style="@style/Card.MyBudget.Surface.Small">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:id="@+id/planFactCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.MyBudget.Section"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/planFactPlanned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/planFactSpent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:id="@+id/planFactDiff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/planFactProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:max="100"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/planFactRunway"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
