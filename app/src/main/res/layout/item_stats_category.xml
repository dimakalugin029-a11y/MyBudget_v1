<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/space_12"
    android:minHeight="72dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">
    <View
        android:id="@+id/statsCategoryColor"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_10"
        android:background="@drawable/statistics_category_accent"
        android:minHeight="48dp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/statsCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            style="@style/Text.MyBudget.Section" />
        <TextView
            android:id="@+id/statsCategoryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/expense_red"
            android:textSize="16sp"
            style="@style/Text.MyBudget.Amount"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>
    <TextView
        android:id="@+id/statsCategoryPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        android:textSize="14sp"
        style="@style/Text.MyBudget.Subtitle"
        android:layout_marginStart="@dimen/space_12" />
</LinearLayout>
