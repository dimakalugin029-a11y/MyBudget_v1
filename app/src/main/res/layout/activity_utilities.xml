<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_16">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            layout="@layout/include_screen_header" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/utilitiesScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Subtitle"
                    android:text="@string/design_utility_object" />
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:id="@+id/utilitySelectedProperty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/design_utility_object"
                    app:icon="@drawable/ic_budget_expand"
                    app:iconGravity="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Subtitle"
                    android:id="@+id/utilitiesLoadStatus"
                    android:text="@string/design_utility_loading"
                    android:paddingVertical="@dimen/space_8"
                    android:minHeight="@dimen/touch_min_size" />
                <androidx.cardview.widget.CardView
                    style="@style/Card.MyBudget.Surface"
                    android:id="@+id/utilityLatestBillCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Section"
                            android:id="@+id/utilityLatestPeriod"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Title"
                            android:id="@+id/utilityLatestTotal"
                            android:text="@string/analysis_value_pending"
                            android:textSize="28sp"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Subtitle"
                            android:id="@+id/utilityLatestStatus"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Subtitle"
                            android:text="@string/design_utility_open_bill"
                            android:layout_marginBottom="@dimen/space_8" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <include
                    android:id="@+id/utilitiesSetupGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/include_utility_setup_guide" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="@string/utilities_subtitle"
                    style="@style/Text.MyBudget.SectionLabel" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    android:text="@string/utility_month_checklist_legend"
                    style="@style/Text.MyBudget.Subtitle" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/utilitiesRecyclerView"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
                <TextView
                    android:gravity="center"
                    android:id="@+id/utilitiesEmptyText"
                    android:padding="@dimen/space_24"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/utilities_empty_months"
                    style="@style/Text.MyBudget.Subtitle" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/utilitiesActionsSheet"
        android:background="@drawable/bg_bottom_sheet_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/card_elevation_low"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <include layout="@layout/include_bottom_sheet_handle" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addUtilityMonthButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/utility_add_month"
            android:layout_marginHorizontal="@dimen/space_16"
            app:cornerRadius="@dimen/radius_12"
            style="@style/Widget.MyBudget.Button" />
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/utilitiesActionsSheetContent"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:paddingBottom="@dimen/space_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_16">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include android:id="@+id/utilityPropertyButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/utilityPaymentDayButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/utilityPayCategoryButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/utilityTemplateButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/utilityTariffsButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/utilityCompareButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/metersButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/exportCommunalButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/importExcelButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/utilityPhotoFolderButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/markLegacyPaidButton" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
