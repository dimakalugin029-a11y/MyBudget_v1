<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.MyBudget.Subtitle"
            android:text="@string/auto_field_amount"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/amountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_amount"
            android:inputType="numberDecimal"
            style="@style/Widget.MyBudget.OperationAmount"
            android:layout_marginBottom="@dimen/space_12" />
        <EditText
            android:id="@+id/dateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_date"
            android:inputType="text"
            style="@style/Widget.MyBudget.OperationInput"
            android:layout_marginBottom="@dimen/space_12" />
        <EditText
            android:id="@+id/endDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_end_date"
            android:inputType="text"
            android:visibility="gone"
            style="@style/Widget.MyBudget.OperationInput"
            android:layout_marginBottom="@dimen/space_12" />
        <EditText
            android:id="@+id/mileageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_mileage"
            android:inputType="number"
            style="@style/Widget.MyBudget.OperationInput"
            android:layout_marginBottom="@dimen/space_12" />
        <EditText
            android:id="@+id/litersInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_liters"
            android:inputType="numberDecimal"
            android:visibility="gone"
            style="@style/Widget.MyBudget.OperationInput"
            android:layout_marginBottom="@dimen/space_12" />
        <EditText
            android:id="@+id/priceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_price"
            android:inputType="numberDecimal"
            android:visibility="gone"
            style="@style/Widget.MyBudget.OperationInput"
            android:layout_marginBottom="@dimen/space_12" />
        <EditText
            android:id="@+id/descInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_field_description"
            android:inputType="textMultiLine"
            style="@style/Widget.MyBudget.OperationInput"
            android:layout_marginBottom="@dimen/space_12" />
        <LinearLayout
            android:id="@+id/itemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addItemButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auto_add_item"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_payment_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/paymentMethodSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@drawable/operation_input_bg" />
        <TextView
            android:id="@+id/autoCategoryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_budget_category"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:background="@drawable/operation_input_bg" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_payment_hint"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
