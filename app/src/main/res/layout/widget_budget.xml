<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/widgetRoot"
    android:background="@color/budget_blue"
    android:padding="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:id="@+id/widgetBudgetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/budget_profiles_default_name"
        android:alpha="0.9"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/widgetBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/budget_balance_zero"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/widgetIncomeButton"
            android:background="@color/income_green"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/shortcut_income"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_6"
            android:paddingVertical="@dimen/space_8"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/widgetExpenseButton"
            android:background="@color/expense_red"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/shortcut_expense"
            android:layout_weight="1"
            android:paddingVertical="@dimen/space_8"/>
    </LinearLayout>
</LinearLayout>
