<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_gradient_dark"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetAppIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_icon_budget"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widgetBudgetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/budget_profiles_default_name"
            android:textColor="@color/widget_text_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_name"
            android:textColor="@color/widget_text_muted_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetBalanceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:letterSpacing="0.06"
        android:text="@string/widget_balance_label"
        android:textAllCaps="true"
        android:textColor="@color/widget_text_secondary_dark"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widgetBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/budget_balance_zero"
        android:textColor="@color/widget_balance_positive_dark"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetIncomeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_6"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_income_dark"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingVertical="@dimen/space_8"
            android:text="@string/shortcut_income"
            android:textColor="@color/widget_income_text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetExpenseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_expense_dark"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingVertical="@dimen/space_8"
            android:text="@string/shortcut_expense"
            android:textColor="@color/widget_expense_text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
