<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/categoryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:text="@string/default_amount_category_label"
    style="@style/Text.MyBudget.SectionLabel"/>
    <EditText style="@style/Widget.MyBudget.OperationInput"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:id="@+id/amountInput"
        android:background="@drawable/operation_input_bg"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/default_amount_value_hint"
        android:inputType="numberDecimal"/>
</LinearLayout>
