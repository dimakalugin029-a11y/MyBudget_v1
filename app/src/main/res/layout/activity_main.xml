<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_light"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12">
            <TextView
                android:textSize="22sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/main_app_title"
                android:layout_weight="1"
                style="@style/Text.MyBudget.Title"/>
            <ImageButton
                android:id="@+id/mainSettingsButton"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/touch_min_size"
                android:layout_height="@dimen/touch_min_size"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="@string/main_menu_settings"
                app:tint="@color/text_secondary"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            style="@style/Card.MyBudget.Surface">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/space_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/mainProfilePicker"
                    android:background="@drawable/quick_filter_chip_bg"
                    android:paddingLeft="@dimen/space_12"
                    android:paddingTop="@dimen/space_6"
                    android:paddingRight="@dimen/space_12"
                    android:paddingBottom="@dimen/space_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_6">
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/mainProfileNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/budget_profiles_default_name"
                        style="@style/Text.MyBudget.Section"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_chevron_down"
                        android:layout_marginStart="@dimen/space_4"/>
                </LinearLayout>
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:id="@+id/mainActiveBalanceText"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/main_balance_placeholder"/>
                <TextView
                    android:textSize="13sp"
                    android:id="@+id/mainTotalAllText"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    style="@style/Text.MyBudget.Subtitle"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mainAttentionSection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/main_section_attention"
                style="@style/Text.MyBudget.Section"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/mainAttentionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Card.MyBudget.Surface">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionPending"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionPendingRow"
                            layout="@layout/include_main_list_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionOverspend"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionOverspendRow"
                            layout="@layout/include_main_list_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionUpcoming"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionUpcomingRow"
                            layout="@layout/include_main_list_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionReminders"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionRemindersRow"
                            layout="@layout/include_main_list_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionGoals"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionGoalsRow"
                            layout="@layout/include_main_list_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionUtilities"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionUtilitiesRow"
                            layout="@layout/include_main_list_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionObligations"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionObligationsRow"
                            layout="@layout/include_main_list_row"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/incomeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/main_primary_income"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                app:backgroundTint="@color/income_green"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/expenseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_6"
                android:layout_marginRight="@dimen/space_6"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/main_primary_expense"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/space_6"
                app:backgroundTint="@color/expense_red"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/budgetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/main_primary_budget"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_6"
                app:backgroundTint="@color/budget_blue"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_analytics"
            style="@style/Text.MyBudget.Section"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            style="@style/Card.MyBudget.Surface">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/transactionsButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/statisticsButton"
                    layout="@layout/include_main_list_row"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_planning"
            style="@style/Text.MyBudget.Section"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            style="@style/Card.MyBudget.Surface">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/expensePlanButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/goalsButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/remindersButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/obligationsButton"
                    layout="@layout/include_main_list_row"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_other"
            style="@style/Text.MyBudget.Section"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Card.MyBudget.Surface">
            <include
                android:id="@+id/utilitiesButton"
                layout="@layout/include_main_list_row"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
