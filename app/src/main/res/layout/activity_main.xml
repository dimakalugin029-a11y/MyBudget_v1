<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_light"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_icon_budget"
                android:textSize="24sp" />
            <TextView
                style="@style/Text.MyBudget.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/main_app_title"
                android:textSize="22sp" />
            <ImageButton
                android:id="@+id/mainSettingsButton"
                android:layout_width="@dimen/touch_min_size"
                android:layout_height="@dimen/touch_min_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/main_menu_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/main_hero_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/widget_balance_label"
                    android:textAllCaps="true"
                    android:textColor="@color/main_hero_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/mainActiveBalanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/main_balance_placeholder"
                    android:textColor="@color/main_hero_balance_positive"
                    android:textSize="34sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/mainSafeToSpendText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/main_hero_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/mainTotalAllText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/main_hero_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/mainProfilePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/main_hero_profile_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_6">
                    <TextView
                        android:id="@+id/mainProfileNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/budget_profiles_default_name"
                        android:textColor="@color/main_hero_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="@string/ui_chevron_down"
                        android:textColor="@color/main_hero_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mainAttentionSection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/main_section_attention"
                style="@style/Text.MyBudget.SectionLabel"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/mainAttentionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Card.MyBudget.Surface"
            app:cardCornerRadius="@dimen/radius_16">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionPending"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionPendingRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionOverspend"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionOverspendRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionIncomePlan"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionIncomePlanRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionUpcoming"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionUpcomingRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionReminders"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionRemindersRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionGoals"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionGoalsRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionUtilities"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionUtilitiesRow"
                            layout="@layout/include_main_attention_row"/>
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/mainAttentionObligations"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/mainAttentionObligationsRow"
                            layout="@layout/include_main_attention_row"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mainSetupChecklistSection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_section_getting_started"
                    style="@style/Text.MyBudget.SectionLabel"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/mainChecklistProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Subtitle"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Card.MyBudget.Surface"
                app:cardCornerRadius="@dimen/radius_16">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/mainChecklistSteps"
                    android:padding="@dimen/space_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="13sp"
                android:gravity="end"
                android:id="@+id/mainChecklistDismiss"
                android:paddingTop="@dimen/space_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_checklist_dismiss"
                android:textColor="@color/budget_blue"/>
        </LinearLayout>
        <TextView
            android:id="@+id/mainShortcutsLabel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_shortcuts"
            style="@style/Text.MyBudget.SectionLabel"/>
        <HorizontalScrollView
            android:id="@+id/mainShortcutsScroll"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/mainShortcutsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/incomeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/main_primary_income"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                app:backgroundTint="@color/income_green"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/expenseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_6"
                android:layout_marginRight="@dimen/space_6"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/main_primary_expense"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/space_6"
                app:backgroundTint="@color/expense_red"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/budgetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/main_primary_budget"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_6"
                app:backgroundTint="@color/budget_blue"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_analytics"
            style="@style/Text.MyBudget.SectionLabel"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            style="@style/Card.MyBudget.Surface"
            app:cardCornerRadius="@dimen/radius_16">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/transactionsButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/statisticsButton"
                    layout="@layout/include_main_list_row"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_planning"
            style="@style/Text.MyBudget.SectionLabel"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            style="@style/Card.MyBudget.Surface"
            app:cardCornerRadius="@dimen/radius_16">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/incomePlanButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/expensePlanButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/goalsButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/paymentCalendarButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/obligationsButton"
                    layout="@layout/include_main_list_row"/>
                <View
                    android:background="@color/border_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/recurringButton"
                    layout="@layout/include_main_list_row"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/main_section_other"
            style="@style/Text.MyBudget.SectionLabel"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Card.MyBudget.Surface"
            app:cardCornerRadius="@dimen/radius_16">
            <include
                android:id="@+id/utilitiesButton"
                layout="@layout/include_main_list_row"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
