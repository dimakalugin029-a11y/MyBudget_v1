<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">
        <TextView
            style="@style/Text.MyBudget.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:text="@string/nav_overview"
            android:textSize="22sp"
            android:id="@+id/mainScreenTitle" />
        <ImageButton
            android:id="@+id/mainSearchButton"
            android:layout_width="@dimen/touch_min_size"
            android:layout_height="@dimen/touch_min_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/main_search"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />
        <ImageButton
            android:id="@+id/mainSettingsButton"
            android:layout_width="@dimen/touch_min_size"
            android:layout_height="@dimen/touch_min_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/main_menu_settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_primary" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/mainContentRoot"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/mainOverviewPanel"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:id="@+id/mainBalanceCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/main_hero_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/widget_balance_label"
                            android:textAllCaps="true"
                            android:textColor="@color/main_hero_text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/mainActiveBalanceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/main_balance_placeholder"
                            android:textColor="@color/main_hero_balance_positive"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mainSafeToSpendText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="@color/main_hero_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/mainMonthForecastText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="@color/main_hero_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/mainTotalAllText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="@color/main_hero_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                        <LinearLayout
                            android:id="@+id/mainProfilePicker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:background="@drawable/main_hero_profile_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/space_12"
                            android:paddingVertical="@dimen/space_6">
                            <TextView
                                android:id="@+id/mainProfileNameText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/budget_profiles_default_name"
                                android:textColor="@color/main_hero_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_4"
                                android:text="@string/ui_chevron_down"
                                android:textColor="@color/main_hero_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mainAddOperationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/main_add_operation"
                    android:layout_marginBottom="@dimen/space_16"
                    app:icon="@drawable/ic_nav_add"
                    app:iconGravity="textStart" />
                <LinearLayout
                    android:id="@+id/mainAttentionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        style="@style/Text.MyBudget.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/main_section_attention" />
                    <androidx.cardview.widget.CardView
                        style="@style/Card.MyBudget.Surface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:id="@+id/mainAttentionItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </androidx.cardview.widget.CardView>
                    <Button
                        android:id="@+id/mainAttentionShowAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/attention_show_all" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mainAttentionInformation"
                    style="@style/Text.MyBudget.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    android:visibility="gone" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/mainSetupChecklistSection"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/main_section_getting_started"
                            style="@style/Text.MyBudget.SectionLabel" />
                        <TextView
                            android:id="@+id/mainChecklistProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Subtitle" />
                    </LinearLayout>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Card.MyBudget.Surface"
                        app:cardCornerRadius="@dimen/radius_16">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/mainChecklistSteps"
                            android:padding="@dimen/space_12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textSize="13sp"
                        android:gravity="end"
                        android:id="@+id/mainChecklistDismiss"
                        android:paddingTop="@dimen/space_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_checklist_dismiss"
                        android:textColor="@color/budget_blue" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mainShortcutsLabel"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/main_section_shortcuts"
                    style="@style/Text.MyBudget.SectionLabel" />
                <HorizontalScrollView
                    android:id="@+id/mainShortcutsScroll"
                    android:visibility="gone"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/mainShortcutsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </HorizontalScrollView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_recent_transactions"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_8"
                    style="@style/Text.MyBudget.Section" />
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:id="@+id/mainRecentItems"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/mainRecentEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/space_16"
                            android:text="@string/main_recent_empty"
                            style="@style/Text.MyBudget.Subtitle" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <include android:id="@+id/transactionsButton" layout="@layout/include_dashboard_menu_row" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mainPlanPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mainPlanBudgetButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_profiles_default_name"
                    android:layout_marginBottom="@dimen/space_12"
                    app:icon="@drawable/ic_nav_budget" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/mainPlanMonth"
                    style="@style/Text.MyBudget.Section"
                    android:textSize="20sp"
                    android:layout_marginBottom="@dimen/space_8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/mainPlanStatus"
                    style="@style/Text.MyBudget.Subtitle"
                    android:text="@string/plan_overview_loading" />
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Section"
                            android:text="@string/plan_overview_income"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/mainPlanIncomePlanned"
                            style="@style/Text.MyBudget.Title"
                            android:text="@string/analysis_value_pending"
                            android:textSize="24sp"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/mainPlanIncomeReceived"
                            style="@style/Text.MyBudget.Subtitle"
                            android:text="@string/analysis_value_pending"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/mainPlanIncomeRemaining"
                            style="@style/Text.MyBudget.Subtitle"
                            android:text="@string/analysis_value_pending"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Subtitle"
                            android:text="@string/plan_overview_income_note" />
                        <include android:id="@+id/incomePlanButton" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Section"
                            android:text="@string/plan_overview_expenses"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/mainPlanExpensePlanned"
                            style="@style/Text.MyBudget.Title"
                            android:text="@string/analysis_value_pending"
                            android:textSize="24sp"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/mainPlanExpenseSpent"
                            style="@style/Text.MyBudget.Subtitle"
                            android:text="@string/analysis_value_pending"
                            android:layout_marginBottom="@dimen/space_8" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.MyBudget.Subtitle"
                            android:text="@string/plan_overview_expense_note" />
                        <include android:id="@+id/expensePlanButton" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Section"
                    android:text="@string/plan_overview_payments"
                    android:layout_marginBottom="@dimen/space_8" />
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <include android:id="@+id/paymentCalendarButton" layout="@layout/include_dashboard_menu_row" />
                        <include android:id="@+id/obligationsButton" layout="@layout/include_dashboard_menu_row" />
                        <include android:id="@+id/recurringButton" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Section"
                    android:text="@string/plan_overview_goals_year"
                    android:layout_marginBottom="@dimen/space_8" />
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <include android:id="@+id/goalsButton" layout="@layout/include_dashboard_menu_row" />
                        <include android:id="@+id/yearBudgetingButton" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mainMorePanel"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_more_intro"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="@dimen/space_16" />
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include android:id="@+id/utilitiesButton" layout="@layout/include_dashboard_menu_row" />
                        <View
                            android:background="@color/border_light"
                            android:layout_width="match_parent"
                            android:layout_height="1dp" />
                        <include android:id="@+id/autoButton" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    style="@style/Card.MyBudget.Surface">
                    <LinearLayout
                        android:id="@+id/mainMoreItems"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include android:id="@+id/mainFamilyRow" layout="@layout/include_dashboard_menu_row" />
                        <include android:id="@+id/mainSettingsRow" layout="@layout/include_dashboard_menu_row" />
                        <include android:id="@+id/mainHelpRow" layout="@layout/include_dashboard_menu_row" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/include_main_navigation" />
</LinearLayout>
