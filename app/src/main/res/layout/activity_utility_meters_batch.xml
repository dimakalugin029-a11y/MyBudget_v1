<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_screen_header"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:text="@string/meter_batch_subtitle"
        style="@style/Text.MyBudget.SectionLabel"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/utilities_hero_card_bg"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meter_reading_date_label"
                android:textColor="@color/main_hero_text_primary"
                android:textSize="14sp"
                style="@style/Text.MyBudget.Section" />
            <EditText
                android:id="@+id/batchDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/transaction_hero_amount_field"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/meter_reading_date_pick"
                android:importantForAutofill="no"
                android:inputType="none"
                android:padding="@dimen/space_8"
                android:textColor="@color/main_hero_text_primary"
                android:textColorHint="@color/transaction_hero_text_hint" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/batchMetersRecycler"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:gravity="center"
        android:id="@+id/batchEmptyText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/meter_batch_empty"
        android:layout_weight="1"
        style="@style/Text.MyBudget.Subtitle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/batchSaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/meter_batch_save"
        app:backgroundTint="@color/utilities_cyan"
        app:cornerRadius="@dimen/radius_10"
        style="@style/Widget.MaterialComponents.Button"/>
</LinearLayout>
