<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    style="@style/Card.MyBudget.Surface">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/transaction_budget_label"
            style="@style/Text.MyBudget.Section"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/transactionBudgetPicker"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_8">
            <TextView
                android:textSize="16sp"
                android:id="@+id/transactionBudgetNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/budget_profiles_default_name"
                android:layout_weight="1"
                style="@style/Text.MyBudget.Title"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_chevron_down"
                android:layout_marginStart="@dimen/space_8"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
