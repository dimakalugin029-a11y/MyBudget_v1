<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_screen_header"/>
    <include
        android:id="@+id/transactionsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_dismissible_hint"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8">
        <com.google.android.material.button.MaterialButton
            android:textSize="13sp"
            android:id="@+id/periodFilterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/transactions_filter_month"
            app:icon="@android:drawable/arrow_down_float"
            app:iconGravity="end"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/searchPanel"
        android:background="@drawable/edittext_border"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:paddingHorizontal="@dimen/space_8">
        <EditText
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:id="@+id/searchEditText"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/transactions_search_hint"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingVertical="@dimen/space_8"/>
        <ImageButton
            android:id="@+id/searchClearButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_8"
            android:visibility="gone"
            android:layout_width="@dimen/touch_min_size"
            android:layout_height="@dimen/touch_min_size"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/transactions_search_clear"
            app:tint="@color/text_secondary"/>
    </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            style="@style/Card.MyBudget.Surface">
            <TextView
                android:textSize="13sp"
                android:gravity="center"
                android:id="@+id/summaryText"
                android:padding="@dimen/space_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transactions_summary_default"
                style="@style/Text.MyBudget.Subtitle"/>
        </androidx.cardview.widget.CardView>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/typeTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/budget_blue"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/budget_blue"
        app:tabTextColor="@color/text_secondary"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionsRecyclerView"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/transactionsEmptyState"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_8">
        <TextView
            android:textSize="14sp"
            android:id="@+id/transactionsEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transactions_empty_filter"
            style="@style/Text.MyBudget.Subtitle"/>
        <Button
            android:id="@+id/resetFiltersButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/transactions_reset_filter"/>
    </LinearLayout>
</LinearLayout>
