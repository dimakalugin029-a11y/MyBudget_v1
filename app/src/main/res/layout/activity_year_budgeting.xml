<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_screen_header"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/yearBudgetPrevYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chip_height"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/year_budget_prev_year"
            android:textColor="@color/main_hero_text_primary"
            android:textSize="14sp"
            app:cornerRadius="@dimen/radius_10"
            app:strokeColor="@color/main_hero_text_primary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <TextView
            android:id="@+id/yearBudgetYearLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/main_hero_text_primary"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/yearBudgetNextYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chip_height"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/year_budget_next_year"
            android:textColor="@color/main_hero_text_primary"
            android:textSize="14sp"
            app:cornerRadius="@dimen/radius_10"
            app:strokeColor="@color/main_hero_text_primary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        style="@style/Card.MyBudget.Surface"
        app:cardCornerRadius="@dimen/radius_16">
        <TextView
            android:id="@+id/yearBudgetSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_12"
            android:textSize="13sp"
            android:textColor="@color/main_hero_text_primary"/>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/yearBudgetCategoryToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/year_budget_category_toggle_show"
        android:textSize="13sp"
        app:cornerRadius="@dimen/radius_10"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/yearBudgetCategorySummaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:visibility="gone"
        style="@style/Card.MyBudget.Surface"
        app:cardCornerRadius="@dimen/radius_16">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/yearBudgetCategorySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_12"
                android:textSize="13sp"
                android:textColor="@color/main_hero_text_primary"/>
        </ScrollView>
    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/yearBudgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/year_budget_empty"
        android:visibility="gone"
        style="@style/Text.MyBudget.Subtitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/yearBudgetList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
