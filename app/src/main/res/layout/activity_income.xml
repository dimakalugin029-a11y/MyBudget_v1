<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/incomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_8">
    <include
        layout="@layout/include_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/incomeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_16">
            <include
                android:id="@+id/incomeHint"
                layout="@layout/include_dismissible_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12" />
            <androidx.cardview.widget.CardView
                style="@style/Card.MyBudget.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        style="@style/Text.MyBudget.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/operation_income_amount"
                        android:labelFor="@id/incomeAmount" />
                    <EditText
                        android:id="@+id/incomeAmount"
                        style="@style/Widget.MyBudget.OperationAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="@string/operation_amount_hint"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:imeOptions="actionNext" />
                    <TextView
                        style="@style/Text.MyBudget.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/transaction_budget_label"
                        android:layout_marginTop="@dimen/space_12" />
                    <LinearLayout
                        android:id="@+id/transactionBudgetPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min_size"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_12"
                        android:background="@drawable/operation_input_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/transactionBudgetNameText"
                            style="@style/Text.MyBudget.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/budget_profiles_default_name" />
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_budget_expand"
                            android:importantForAccessibility="no"
                            app:tint="@color/md_theme_primary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                style="@style/Card.MyBudget.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        style="@style/Text.MyBudget.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/income_category_label"
                        android:layout_marginBottom="@dimen/space_8"
                        android:labelFor="@id/incomeCategory" />
                    <Spinner
                        android:id="@+id/incomeCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="@drawable/operation_input_bg"
                        android:padding="@dimen/space_4" />
                    <TextView
                        android:id="@+id/selectedBalanceText"
                        style="@style/Text.MyBudget.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/incomePlanSuggestions"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                android:visibility="gone">
                <TextView
                    style="@style/Text.MyBudget.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/income_plan_suggestion_title" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/incomePlanSuggestionChips"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_8" />
                </HorizontalScrollView>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/incomePlanSourcePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/income_source_choose"
                style="@style/Widget.Material3.Button.OutlinedButton" />
<include layout="@layout/include_income_receipt_status" />
            <TextView
                android:id="@+id/incomePlanBinding"
                style="@style/Text.MyBudget.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_12"
                android:background="@drawable/operation_input_bg"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/incomePlanUnbind"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/income_plan_unbind"
                android:visibility="gone" />
            <androidx.cardview.widget.CardView
                style="@style/Card.MyBudget.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        style="@style/Text.MyBudget.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/operation_comment_optional"
                        android:layout_marginBottom="@dimen/space_8"
                        android:labelFor="@id/incomeDescription" />
                    <EditText
                        android:id="@+id/incomeDescription"
                        style="@style/Widget.MyBudget.OperationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/operation_comment_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="2"
                        android:maxLines="4" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/coverOverspendIncomeButton"
                style="@style/Widget.MyBudget.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/income_cover_overspend" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/distributeIncomeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/operation_distribute_income" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_8">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveIncomeButton"
            style="@style/Widget.MyBudget.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/operation_save_income" />
    </LinearLayout>
</LinearLayout>
