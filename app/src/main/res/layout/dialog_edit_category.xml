<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:text="@string/budget_edit_article_title"
        style="@style/Text.MyBudget.Title"/>
    <TextView
        android:textSize="14sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:text="@string/budget_article_name_label"
        style="@style/Text.MyBudget.Section"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:id="@+id/categoryNameEdit"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:hint="@string/budget_name_hint"/>
    <TextView
        android:textSize="14sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:text="@string/budget_planned_amount_label"
        style="@style/Text.MyBudget.Section"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:id="@+id/plannedAmountEdit"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_20"
        android:hint="@string/budget_planned_short_hint"
        android:inputType="numberDecimal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@android:string/cancel"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_8"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/save"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:backgroundTint="@color/income_green"/>
    </LinearLayout>
</LinearLayout>
