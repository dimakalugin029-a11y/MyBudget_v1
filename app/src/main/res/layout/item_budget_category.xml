<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    style="@style/Card.MyBudget.Surface">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/dragHandle"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_drag_handle"
                android:contentDescription="@string/budget_drag_handle_desc"
                android:layout_marginEnd="@dimen/space_4"
                android:paddingHorizontal="@dimen/space_4"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/expandIndicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"/>
            <View
                android:id="@+id/colorStrip"
                android:visibility="gone"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_8"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/categoryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Section"/>
                <TextView
                    android:textSize="11sp"
                    android:id="@+id/categoryPlanned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    style="@style/Text.MyBudget.Subtitle"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/income_green"
                android:id="@+id/categoryBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Text.MyBudget.Amount"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/categoryPlanRow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">
            <ProgressBar
                android:id="@+id/categoryPlanProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="11sp"
                android:id="@+id/categoryPlanText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                style="@style/Text.MyBudget.Subtitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6">
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:id="@+id/buttonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <CheckBox
                android:id="@+id/selectCheckbox"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
