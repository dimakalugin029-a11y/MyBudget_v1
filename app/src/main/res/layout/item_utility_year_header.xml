<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:layout_marginBottom="@dimen/space_4"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
    style="@style/Card.MyBudget.Surface.Small">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="17sp"
                android:id="@+id/yearHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Text.MyBudget.Section"/>
            <TextView
                android:id="@+id/yearHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                style="@style/Text.MyBudget.Subtitle"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/utilities_cyan"
            android:id="@+id/yearHeaderExpandIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
