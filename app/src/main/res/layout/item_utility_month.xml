<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:foreground="?android:attr/selectableItemBackground"
    style="@style/Card.MyBudget.Surface">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="18sp"
                android:id="@+id/periodText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.MyBudget.Section"/>
            <TextView
                android:textSize="13sp"
                android:id="@+id/areaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                style="@style/Text.MyBudget.Subtitle"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/badgeText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/paymentStatusText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/checklistText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/utilities_cyan"
            android:id="@+id/totalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.MyBudget.Amount"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
