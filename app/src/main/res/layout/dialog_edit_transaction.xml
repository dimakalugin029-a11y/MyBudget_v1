<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/transaction_edit_category"
style="@style/Text.MyBudget.SectionLabel"/>
    <Spinner
        android:id="@+id/editCategorySpinner"
        android:padding="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"/>
    <TextView
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/transaction_edit_amount"
style="@style/Text.MyBudget.SectionLabel"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:id="@+id/editAmountInput"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:hint="@string/transaction_edit_amount_hint"
        android:inputType="numberDecimal"/>
    <TextView
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/transaction_edit_description"
style="@style/Text.MyBudget.SectionLabel"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:id="@+id/editDescriptionInput"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:hint="@string/transaction_edit_description_hint"/>
    <TextView
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/transaction_edit_participant"
style="@style/Text.MyBudget.SectionLabel"/>
    <Spinner
        android:id="@+id/editParticipantSpinner"
        android:padding="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
