<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/expenseDistributionRoot"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        layout="@layout/include_screen_header"/>
    <include
        android:id="@+id/expenseDistributionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/include_dismissible_hint"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/distributionFormGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        style="@style/Card.MyBudget.Surface">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/expense_distribution_total_label"
                style="@style/Text.MyBudget.Section"/>
            <EditText
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:id="@+id/totalExpenseInput"
                android:background="@drawable/edittext_border"
                android:padding="@dimen/space_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/expense_distribution_total_hint"
                android:inputType="numberDecimal"/>
            <TextView
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/expense_distribution_note_label"
                style="@style/Text.MyBudget.Section"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:id="@+id/expenseNoteInput"
                android:background="@drawable/edittext_border"
                android:padding="@dimen/space_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/expense_distribution_note_hint"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/distributionControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addCategoryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/distribution_add_categories"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                app:cornerRadius="@dimen/radius_10"
                app:strokeColor="@color/budget_blue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/distributeRemainderButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/expense_distribution_remainder"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_6"
                app:cornerRadius="@dimen/radius_10"
                app:strokeColor="@color/expense_red"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoriesRecyclerView"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        app:cardBackgroundColor="@color/primary_green_light"
        style="@style/Card.MyBudget.Surface">
        <TextView
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/totalAmountText"
            android:padding="@dimen/space_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expense_distribution_totals_default"
            style="@style/Text.MyBudget.Section"/>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:id="@+id/distributeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/expense_distribution_submit"
        app:backgroundTint="@color/expense_red"
        app:cornerRadius="@dimen/radius_10"
        style="@style/Widget.MaterialComponents.Button"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"/>
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/emptyText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/distribution_add_categories_hint"
        style="@style/Text.MyBudget.Subtitle"/>
</LinearLayout>
