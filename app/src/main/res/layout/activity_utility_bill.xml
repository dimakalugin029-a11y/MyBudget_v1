<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:fitsSystemWindows="true" android:background="@color/background_light">
<include layout="@layout/include_screen_header" />
<androidx.core.widget.NestedScrollView android:id="@+id/utilityBillScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<androidx.cardview.widget.CardView style="@style/Card.MyBudget.Surface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/billPeriodTitle" style="@style/Text.MyBudget.Section" android:layout_width="match_parent" android:layout_height="wrap_content" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/utility_visual_bill_total" style="@style/Text.MyBudget.Subtitle" />
<TextView android:id="@+id/billGrandTotal" style="@style/Text.MyBudget.Amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:textIsSelectable="true" />
<TextView android:id="@+id/billPaymentStatusText" style="@style/Text.MyBudget.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/utility_payment_status_bg" />
</LinearLayout></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:id="@+id/billPaymentDetailsCard" style="@style/Card.MyBudget.Surface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
<TextView style="@style/Text.MyBudget.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/utility_visual_payment_details" />
<TextView android:id="@+id/billPaymentDetailsText" style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textIsSelectable="true" />
</LinearLayout></androidx.cardview.widget.CardView>
<com.google.android.material.button.MaterialButton android:id="@+id/billInfoToggle" style="@style/Widget.MyBudget.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/utility_visual_show_details" />
<LinearLayout android:id="@+id/billInfoDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:visibility="gone" android:background="@drawable/utility_payment_status_bg">
<TextView android:id="@+id/billAreaText" style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" />
<TextView android:id="@+id/billChecklistText" style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
<TextView android:id="@+id/billForecastText" style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/openPhotosButton" style="@style/Widget.MyBudget.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/utility_photos_open" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
<com.google.android.material.button.MaterialButton android:id="@+id/applyMetersButton" style="@style/Widget.MyBudget.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/utility_bill_apply_meters" />
<com.google.android.material.button.MaterialButton android:id="@+id/hideZeroLinesButton" style="@style/Widget.MyBudget.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/utility_bill_hide_zeros" />
</LinearLayout>
<TextView style="@style/Text.MyBudget.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/utility_visual_services" />
<TextView style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:text="@string/utility_bill_lines_hint" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/billDetailsRecyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:paddingBottom="8dp" android:clipToPadding="false" />
</LinearLayout></androidx.core.widget.NestedScrollView>
<com.google.android.material.button.MaterialButton android:id="@+id/payFromBudgetButton" style="@style/Widget.MyBudget.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/utility_pay_from_budget" />
</LinearLayout>
