<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:text="@string/reminder_dialog_new_title"
            style="@style/Text.MyBudget.Title"/>
        <TextView
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="@string/reminder_title_label"
            style="@style/Text.MyBudget.Section"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:id="@+id/reminderTitleInput"
            android:background="@drawable/edittext_border"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:hint="@string/reminder_title_example_hint"/>
        <TextView
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="@string/reminder_amount_label"
            style="@style/Text.MyBudget.Section"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:id="@+id/reminderAmountInput"
            android:background="@drawable/edittext_border"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:hint="@string/reminder_amount_hint"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="@string/reminder_category_label"
            style="@style/Text.MyBudget.Section"/>
        <Spinner
            android:id="@+id/reminderCategorySpinner"
            android:padding="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"/>
        <TextView
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="@string/reminder_date_label"
            style="@style/Text.MyBudget.Section"/>
        <Button
            android:id="@+id/reminderDateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/reminder_pick_date"/>
        <TextView
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="@string/reminder_repeat_label"
            style="@style/Text.MyBudget.Section"/>
        <Spinner
            android:id="@+id/reminderRepeatSpinner"
            android:padding="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"/>
    </LinearLayout>
</ScrollView>
