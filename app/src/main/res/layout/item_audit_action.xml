<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_6"
    style="@style/Card.MyBudget.Surface.Small">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/statistics_category_accent" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_12">
            <TextView
                android:id="@+id/auditActionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                style="@style/Text.MyBudget.Section" />
            <TextView
                android:id="@+id/auditActionDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                style="@style/Text.MyBudget.Subtitle" />
            <TextView
                android:id="@+id/auditActionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/text_secondary"
                style="@style/Text.MyBudget.Subtitle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auditActionUndoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/audit_action_undo"
                app:cornerRadius="@dimen/radius_12"
                style="@style/Widget.MyBudget.Button.Text" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
