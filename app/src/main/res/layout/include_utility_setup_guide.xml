<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/utilitySetupGuide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    app:cardBackgroundColor="@color/utilities_cyan_light"
    style="@style/Card.MyBudget.Surface.Small">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:id="@+id/utilitySetupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/utility_setup_title"
                android:layout_weight="1"
                style="@style/Text.MyBudget.Section"/>
            <ImageButton
                android:id="@+id/utilitySetupDismiss"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/space_8"
                android:layout_width="@dimen/touch_min_size"
                android:layout_height="@dimen/touch_min_size"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/hint_dismiss"
                app:tint="@color/text_secondary"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:id="@+id/utilitySetupStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:lineSpacingExtra="@dimen/space_2"
            style="@style/Text.MyBudget.Subtitle"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:id="@+id/utilitySetupStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:lineSpacingExtra="@dimen/space_2"
            style="@style/Text.MyBudget.Subtitle"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:id="@+id/utilitySetupStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:lineSpacingExtra="@dimen/space_2"
            style="@style/Text.MyBudget.Subtitle"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/utilitySetupNote"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
