<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/expensePlanRoot"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_screen_header"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <LinearLayout
            android:id="@+id/expensePlanTopPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/screen_hero_card_bg_blue"
            android:orientation="vertical"
            android:padding="@dimen/space_16">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/transaction_budget_label"
                android:textAllCaps="true"
                android:textColor="@color/screen_hero_blue_text_secondary"
                android:textSize="11sp" />
            <LinearLayout
                android:id="@+id/transactionBudgetPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/main_hero_profile_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_12"
                android:paddingVertical="@dimen/space_6">
                <TextView
                    android:id="@+id/transactionBudgetNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/budget_profiles_default_name"
                    android:textColor="@color/main_hero_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="@string/ui_chevron_down"
                    android:textColor="@color/screen_hero_blue_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expensePlanPrevMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/chip_height"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/space_10"
                    android:text="@string/expense_plan_prev_month"
                    android:textColor="@color/main_hero_text_primary"
                    android:textSize="14sp"
                    app:cornerRadius="@dimen/radius_10"
                    app:strokeColor="@color/main_hero_text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <TextView
                    android:id="@+id/expensePlanMonthLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/main_hero_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    style="@style/Text.MyBudget.Section"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expensePlanNextMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/chip_height"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/space_10"
                    android:text="@string/expense_plan_next_month"
                    android:textColor="@color/main_hero_text_primary"
                    android:textSize="14sp"
                    app:cornerRadius="@dimen/radius_10"
                    app:strokeColor="@color/main_hero_text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
            <TextView
                android:id="@+id/expensePlanSummaryLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/screen_hero_blue_text_secondary"
                android:textSize="13sp"
                style="@style/Text.MyBudget.Subtitle"/>
            <LinearLayout
                android:id="@+id/expensePlanActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expensePlanFillDefaults"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/expense_plan_fill_defaults"
                    android:textColor="@color/main_hero_text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="@dimen/radius_10"
                    app:strokeColor="@color/main_hero_text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expensePlanSaveDefaults"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/expense_plan_save_defaults"
                    android:textColor="@color/main_hero_text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="@dimen/radius_10"
                    app:strokeColor="@color/main_hero_text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/expensePlanRecycler"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/expensePlanEmpty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/expense_plan_empty"
        android:layout_weight="1"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/expensePlanOverspendPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        style="@style/Card.MyBudget.Surface">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_12"
            android:paddingTop="@dimen/space_10"
            android:paddingRight="@dimen/space_12"
            android:paddingBottom="@dimen/space_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_10">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overspend_settings_title"
                    android:layout_weight="1"
                    style="@style/Text.MyBudget.Section"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/expensePlanOverspendSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <EditText
                android:textSize="14sp"
                android:id="@+id/expensePlanThresholdInput"
                android:background="@drawable/edittext_border"
                android:padding="@dimen/space_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:hint="@string/overspend_threshold_hint"
                android:inputType="number"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
