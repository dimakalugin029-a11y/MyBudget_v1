<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    style="@style/Card.MyBudget.Surface">
    <LinearLayout
        android:orientation="horizontal"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/statusIndicator"
            android:background="@color/income_green"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_12"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/reminderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/Text.MyBudget.Section"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/reminderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    style="@style/Text.MyBudget.Subtitle"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/income_green"
                    android:id="@+id/reminderAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.MyBudget.Amount"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:id="@+id/reminderCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/space_12"
                    style="@style/Text.MyBudget.Subtitle"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:id="@+id/reminderRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                style="@style/Text.MyBudget.Subtitle"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="11sp"
            android:layout_gravity="center_vertical"
            android:id="@+id/payReminderButton"
            android:paddingLeft="@dimen/space_8"
            android:paddingRight="@dimen/space_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:text="@string/reminder_mark_paid"
            android:layout_marginStart="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_8"
            app:cornerRadius="@dimen/radius_10"
            app:strokeColor="@color/income_green"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="13sp"
            android:textColor="@color/expense_red"
            android:layout_gravity="center_vertical"
            android:id="@+id/deleteReminderButton"
            android:padding="@dimen/space_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/ui_delete"
            android:contentDescription="@string/reminder_delete_content_description"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
