<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_screen_header"/>
    <include
        android:id="@+id/budgetHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        layout="@layout/include_dismissible_hint"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/budgetBalanceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/main_hero_card_bg"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_10">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:text="@string/budget_balance_label"
                    android:textAllCaps="true"
                    android:textColor="@color/main_hero_text_secondary"
                    android:textSize="11sp"/>
                <LinearLayout
                    android:id="@+id/activeBudgetPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/main_hero_profile_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_8"
                    android:paddingVertical="@dimen/space_4">
                    <TextView
                        android:id="@+id/activeBudgetNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/budget_profiles_default_name"
                        android:textColor="@color/main_hero_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/ui_chevron_down"
                        android:textColor="@color/main_hero_text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/totalBalanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/budget_balance_zero"
                android:textColor="@color/main_hero_balance_positive"
                android:textSize="28sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/safeToSpendText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textColor="@color/main_hero_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/selectionBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        style="@style/Card.MyBudget.Surface">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:textSize="12sp"
                android:id="@+id/selectModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/budget_select_mode"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_4"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="12sp"
                android:id="@+id/hideSelectedButton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_4"
                android:layout_marginRight="@dimen/space_4"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/budget_hide_selected"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/space_4"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="12sp"
                android:id="@+id/deleteSelectedButton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_4"
                android:layout_marginRight="@dimen/space_4"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/budget_delete_selected"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/space_4"
                app:backgroundTint="@color/expense_red"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="12sp"
                android:id="@+id/cancelSelectButton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@android:string/cancel"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8">
        <HorizontalScrollView
            android:scrollbars="none"
            android:fadingEdgeLength="@dimen/space_12"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:requiresFadingEdge="horizontal"
            android:paddingEnd="40dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/budgetFilterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/budgetFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_filter_all"
                    android:layout_marginEnd="@dimen/space_6"
                    style="@style/Chip.MyBudget.Filter"/>
                <TextView
                    android:id="@+id/budgetFilterNonZero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_filter_non_zero"
                    android:layout_marginEnd="@dimen/space_6"
                    style="@style/Chip.MyBudget.Filter"/>
                <TextView
                    android:id="@+id/budgetFilterOverspend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_filter_overspend"
                    style="@style/Chip.MyBudget.Filter"/>
            </LinearLayout>
        </HorizontalScrollView>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/budgetExpandToggle"
            android:background="@drawable/budget_expand_toggle_bg"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/touch_min_size"
            android:layout_height="@dimen/chip_height"
            android:text="@string/budget_expand_all"
            android:contentDescription="@string/budget_expand_subcategories"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            style="@style/Chip.MyBudget.Filter"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/categoriesScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/categoriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <TextView
            android:gravity="center"
            android:id="@+id/budgetLoadingState"
            android:padding="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/budget_loading"
            style="@style/Text.MyBudget.Subtitle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/budgetEmptyState"
            android:padding="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/budget_empty"
            style="@style/Text.MyBudget.Subtitle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/budgetErrorState"
            android:padding="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Text.MyBudget.Subtitle"/>
    </FrameLayout>
</LinearLayout>
