<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_light">
    <include layout="@layout/include_screen_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/coverageStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balance_coverage_loading" style="@style/Text.MyBudget.Subtitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/coverage_target_label" style="@style/Text.MyBudget.Section" android:labelFor="@id/coverageTarget" />
            <Spinner android:id="@+id/coverageTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balance_coverage_sources" style="@style/Text.MyBudget.Section" />
            <LinearLayout android:id="@+id/coverageSources" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/coveragePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balance_coverage_confirm" android:enabled="false" />
            <Button android:id="@+id/coverageOpenBudget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_menu_budget" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
