<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/forecastMonthTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.MyBudget.Section"/>
    <TextView
        android:id="@+id/forecastMonthIncome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        style="@style/Text.MyBudget.Subtitle"/>
    <TextView
        android:id="@+id/forecastMonthExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.MyBudget.Subtitle"/>
    <TextView
        android:id="@+id/forecastMonthNet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.MyBudget.Subtitle"/>
    <TextView
        android:id="@+id/forecastMonthBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.MyBudget.Subtitle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/forecastMonthToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/forecast_show_details"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
    <TextView
        android:id="@+id/forecastMonthDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        style="@style/Text.MyBudget.Subtitle"/>
</LinearLayout>
