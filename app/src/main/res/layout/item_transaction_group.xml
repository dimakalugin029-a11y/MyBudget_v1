<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:paddingLeft="@dimen/space_4"
    android:paddingTop="@dimen/space_10"
    android:paddingRight="@dimen/space_4"
    android:paddingBottom="@dimen/space_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_10">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/groupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/groupSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:id="@+id/groupAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_4"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:id="@+id/groupExpandIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_2"/>
    <ImageButton
        android:id="@+id/groupActionsButton"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_8"
        android:layout_width="@dimen/touch_min_size"
        android:layout_height="@dimen/touch_min_size"
        android:src="@android:drawable/ic_menu_more"
        android:contentDescription="@string/transaction_group_actions"
        app:tint="@color/text_secondary"/>
</LinearLayout>
