<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_24"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_24">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/screen_hero_card_bg_blue"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_24">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_screen_emoji"
                android:textSize="40sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/lock_title"
                android:textColor="@color/main_hero_text_primary"
                android:textSize="22sp"
                style="@style/Text.MyBudget.Title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/lock_subtitle"
                android:textColor="@color/screen_hero_blue_text_secondary"
                android:textSize="14sp"
                style="@style/Text.MyBudget.Subtitle" />
            <EditText
                android:id="@+id/lockPinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/transaction_hero_amount_field"
                android:gravity="center"
                android:hint="@string/lock_pin_hint"
                android:imeOptions="actionDone"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:minHeight="@dimen/touch_min_size"
                android:padding="@dimen/space_12"
                android:textColor="@color/main_hero_text_primary"
                android:textColorHint="@color/transaction_hero_text_hint"
                android:textSize="22sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockUnlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/lock_unlock"
                android:textColor="@color/main_hero_text_primary"
                app:backgroundTint="@color/budget_blue"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockBiometricButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/lock_use_biometric"
                android:textColor="@color/main_hero_text_primary"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
