<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_24"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_24">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_16"
        style="@style/Card.MyBudget.Surface">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="40sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_screen_emoji"/>
            <TextView
                android:textSize="22sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/lock_title"
                style="@style/Text.MyBudget.Title"/>
            <TextView
                android:textSize="14sp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/lock_subtitle"
                style="@style/Text.MyBudget.Subtitle"/>
            <EditText
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/lockPinInput"
                android:background="@drawable/edittext_border"
                android:padding="@dimen/space_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:minHeight="@dimen/touch_min_size"
                android:hint="@string/lock_pin_hint"
                android:maxLength="6"
                android:inputType="numberPassword"
                android:imeOptions="actionDone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockUnlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/lock_unlock"
                app:backgroundTint="@color/budget_blue"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockBiometricButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/lock_use_biometric"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
