<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_10"
    android:layout_marginBottom="@dimen/space_6"
    android:background="@drawable/budget_parent_header_bg"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="top"
    android:paddingHorizontal="@dimen/space_12"
    android:paddingVertical="@dimen/space_10">
    <View
        android:id="@+id/colorStrip"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_gravity="fill_vertical"
        android:minHeight="36dp"
        android:layout_marginEnd="@dimen/space_10"
        android:visibility="gone"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/categoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Text.MyBudget.Section"/>
        <TextView
            android:id="@+id/categoryMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textSize="11sp"
            android:visibility="gone"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
    <TextView
        android:id="@+id/categoryBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/space_8"
        android:textSize="15sp"
        android:textStyle="bold"
        style="@style/Text.MyBudget.Amount"/>
</LinearLayout>
