<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:layout_marginTop="@dimen/space_8" android:layout_marginBottom="@dimen/space_6"
    android:background="@drawable/budget_parent_header_bg" android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical" android:padding="@dimen/space_12">
    <View android:id="@+id/colorStrip" android:layout_width="4dp" android:layout_height="match_parent"
        android:minHeight="56dp" android:layout_marginEnd="@dimen/space_10" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/categoryName" style="@style/Text.MyBudget.Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="17sp" />
        <TextView android:id="@+id/categoryBalance" style="@style/Text.MyBudget.Amount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:textSize="18sp" />
        <TextView android:id="@+id/categoryMeta" style="@style/Text.MyBudget.Subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:visibility="gone" />
    </LinearLayout>
    <ImageButton android:id="@+id/categoryExpandButton" android:layout_width="@dimen/touch_min_size" android:layout_height="@dimen/touch_min_size"
        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_budget_expand"
        android:padding="@dimen/space_12" app:tint="@color/md_theme_primary" />
    <ImageButton android:id="@+id/categoryMenuButton" android:layout_width="@dimen/touch_min_size" android:layout_height="@dimen/touch_min_size"
        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_nav_more"
        android:padding="@dimen/space_12" app:tint="@color/text_secondary" />
    <ImageButton android:id="@+id/dragHandle" android:layout_width="@dimen/touch_min_size" android:layout_height="@dimen/touch_min_size"
        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_drag_handle"
        android:contentDescription="@string/budget_drag_handle_desc" android:visibility="gone"
        android:padding="@dimen/space_12" app:tint="@color/text_secondary" />
</LinearLayout>
