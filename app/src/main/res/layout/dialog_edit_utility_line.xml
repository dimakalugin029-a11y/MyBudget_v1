<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/utility_line_qty_label"
            style="@style/Text.MyBudget.Subtitle"/>
        <EditText
            android:textColor="@color/text_primary"
            android:id="@+id/quantityInput"
            android:background="@drawable/edittext_border"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:hint="@string/utility_not_set_hint"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/utility_line_tariff_label"
            style="@style/Text.MyBudget.Subtitle"/>
        <EditText
            android:textColor="@color/text_primary"
            android:id="@+id/tariffInput"
            android:background="@drawable/edittext_border"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:hint="@string/utility_not_set_hint"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/utility_line_total_label"
            style="@style/Text.MyBudget.Subtitle"/>
        <EditText
            android:textColor="@color/text_primary"
            android:id="@+id/amountInput"
            android:background="@drawable/edittext_border"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="11sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/utility_bill_line_calc_hint"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
</ScrollView>
