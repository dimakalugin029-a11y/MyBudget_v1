<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/expenseRoot"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        layout="@layout/include_screen_header"/>
    <include
        android:id="@+id/expenseHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        layout="@layout/include_dismissible_hint"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/expenseScroll"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/transaction_hero_card_bg_expense"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/transaction_budget_label"
                        android:textAllCaps="true"
                        android:textColor="@color/transaction_hero_expense_text_secondary"
                        android:textSize="11sp" />
                    <LinearLayout
                        android:id="@+id/transactionBudgetPicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:background="@drawable/main_hero_profile_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_6">
                        <TextView
                            android:id="@+id/transactionBudgetNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/budget_profiles_default_name"
                            android:textColor="@color/transaction_hero_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:text="@string/ui_chevron_down"
                            android:textColor="@color/transaction_hero_expense_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:letterSpacing="0.06"
                        android:text="@string/expense_amount_label"
                        android:textAllCaps="true"
                        android:textColor="@color/transaction_hero_expense_text_secondary"
                        android:textSize="11sp" />
                    <EditText
                        android:id="@+id/expenseAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/transaction_hero_amount_field"
                        android:hint="@string/expense_amount_hint"
                        android:inputType="numberDecimal"
                        android:padding="@dimen/space_12"
                        android:textColor="@color/transaction_hero_text_primary"
                        android:textColorHint="@color/transaction_hero_text_hint"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/expense_category_label"
                style="@style/Text.MyBudget.SectionLabel" />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                style="@style/Card.MyBudget.Surface">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Spinner
                        android:id="@+id/expenseCategory"
                        android:padding="@dimen/space_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/selectedBalanceText"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        style="@style/Text.MyBudget.Subtitle"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/expense_description_label"
                style="@style/Text.MyBudget.SectionLabel"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                style="@style/Card.MyBudget.Surface">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:id="@+id/expenseDescription"
                        android:background="@drawable/edittext_border"
                        android:padding="@dimen/space_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/expense_description_hint"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveExpenseButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/expense_save_single"
                app:backgroundTint="@color/expense_red"
                app:cornerRadius="@dimen/radius_10"
                style="@style/Widget.MaterialComponents.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/distributeExpenseButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/expense_distribute_multi"
                app:cornerRadius="@dimen/radius_10"
                app:strokeColor="@color/expense_red"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.1"/>
    </LinearLayout>
</LinearLayout>
