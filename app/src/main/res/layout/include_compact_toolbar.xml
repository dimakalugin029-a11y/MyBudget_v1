<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/screenHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_min_size">
    <ImageButton
        android:id="@+id/screenHeaderBack"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_8"
        android:layout_width="@dimen/touch_min_size"
        android:layout_height="@dimen/touch_min_size"
        android:src="@drawable/ic_arrow_back"
        android:scaleType="centerInside"
        android:contentDescription="@string/nav_back"
        app:tint="@color/text_primary"/>
    <TextView
        android:textSize="18sp"
        android:id="@+id/screenHeaderEmoji"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"/>
    <TextView
        android:textSize="20sp"
        android:ellipsize="end"
        android:id="@+id/screenHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_4"
        style="@style/Text.MyBudget.Title"/>
    <ImageButton
        android:id="@+id/screenHeaderAction"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="@dimen/touch_min_size"
        android:layout_height="@dimen/touch_min_size"
        android:src="@android:drawable/ic_menu_more"
        android:contentDescription="@string/transactions_more_menu"
        app:tint="@color/text_secondary"/>
    <ImageButton
        android:id="@+id/screenHeaderActionSecondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="@dimen/touch_min_size"
        android:layout_height="@dimen/touch_min_size"
        android:src="@android:drawable/ic_menu_search"
        android:contentDescription="@string/transactions_search_submit"
        app:tint="@color/budget_blue"/>
</LinearLayout>
