<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/transaction_edit_amount"
        android:textSize="14sp"
        style="@style/Text.MyBudget.SectionLabel"/>
    <EditText
        android:id="@+id/addTransactionAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:background="@drawable/edittext_border"
        android:hint="@string/budget_amount_hint"
        android:inputType="numberDecimal"
        android:padding="@dimen/space_12"
        android:textColor="@color/text_primary"
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/addTransactionDescriptionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/income_description_label"
        android:textSize="14sp"
        style="@style/Text.MyBudget.SectionLabel"/>
    <EditText
        android:id="@+id/addTransactionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edittext_border"
        android:hint="@string/income_description_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:padding="@dimen/space_12"
        android:textColor="@color/text_primary"
        android:textSize="16sp"/>
</LinearLayout>
