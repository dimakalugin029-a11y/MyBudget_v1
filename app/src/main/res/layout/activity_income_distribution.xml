<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/incomeDistributionRoot"
    android:background="@color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingRight="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_16">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            layout="@layout/include_screen_header"/>
        <include
            android:id="@+id/incomeDistributionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            layout="@layout/include_dismissible_hint"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/distributionModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/income_distribution_choose_mode"
            style="@style/Text.MyBudget.Subtitle"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:id="@+id/addCategoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/distribution_add_categories"
            app:cornerRadius="@dimen/radius_10"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:strokeColor="@color/budget_blue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8">
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:id="@+id/applyDefaultsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/income_distribution_defaults"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                app:strokeColor="@color/budget_blue"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:id="@+id/manualEntryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_size"
                android:text="@string/income_distribution_manual"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_6"
                app:strokeColor="@color/settings_orange"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoriesRecyclerView"
            android:paddingBottom="@dimen/space_8"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            app:cardBackgroundColor="@color/primary_green_light"
            style="@style/Card.MyBudget.Surface">
            <TextView
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/totalAmountText"
                android:padding="@dimen/space_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/income_distribution_totals_default"
                style="@style/Text.MyBudget.Section"/>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.button.MaterialButton
            android:textSize="15sp"
            android:id="@+id/distributeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/income_distribution_submit"
            app:backgroundTint="@color/income_green"
            app:cornerRadius="@dimen/radius_10"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/emptyText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/distribution_add_categories_hint"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/incomeDistributionActionsSheet"
        android:background="@drawable/bg_bottom_sheet_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/card_elevation_low"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <include layout="@layout/include_bottom_sheet_handle"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/distributionControlsGroup"
            android:paddingLeft="@dimen/space_16"
            android:paddingRight="@dimen/space_16"
            android:paddingBottom="@dimen/space_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_16">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Card.MyBudget.Surface">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/incomeDistributionPlanRow"
                        layout="@layout/include_main_list_row"/>
                    <View
                        android:background="@color/border_light"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <include
                        android:id="@+id/incomeDistributionObligationsRow"
                        layout="@layout/include_main_list_row"/>
                    <View
                        android:background="@color/border_light"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <include
                        android:id="@+id/incomeDistributionGoalsRow"
                        layout="@layout/include_main_list_row"/>
                    <View
                        android:background="@color/border_light"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <include
                        android:id="@+id/incomeDistributionRemainderRow"
                        layout="@layout/include_main_list_row"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
