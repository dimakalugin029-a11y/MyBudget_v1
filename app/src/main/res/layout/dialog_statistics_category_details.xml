<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_16">
    <TextView
        android:textSize="17sp"
        android:id="@+id/categorySheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stats_dialog_category"
        style="@style/Text.MyBudget.Title"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/expense_red"
        android:id="@+id/categorySheetTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/stats_dialog_total_default"/>
    <TextView
        android:id="@+id/categorySheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/stats_dialog_operations"
        style="@style/Text.MyBudget.Subtitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categorySheetRecycler"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="@dimen/space_10"/>
    <TextView
        android:textSize="13sp"
        android:gravity="center"
        android:id="@+id/categorySheetEmpty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stats_dialog_no_operations"
        style="@style/Text.MyBudget.Subtitle"/>
</LinearLayout>
