<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/remainderDistributionRoot"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        layout="@layout/include_screen_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/distributionControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/sourceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/transaction_hero_card_bg_income"
                android:gravity="center"
                android:padding="@dimen/space_16"
                android:text="@string/income_distribution_parent_fallback"
                android:textColor="@color/main_hero_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                style="@style/Text.MyBudget.Section"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/remainder_pick_categories"
            style="@style/Text.MyBudget.SectionLabel"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoriesRecyclerView"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <TextView
            android:id="@+id/totalAmountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/transaction_hero_card_bg_income"
            android:gravity="center"
            android:padding="@dimen/space_16"
            android:text="@string/income_distribution_totals_default"
            android:textColor="@color/main_hero_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            style="@style/Text.MyBudget.Section"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fillButtonsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8">
        <com.google.android.material.button.MaterialButton
            android:textSize="12sp"
            android:id="@+id/fillEqualButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/remainder_fill_equal"
            android:layout_weight="1"
            app:cornerRadius="@dimen/radius_10"
            app:strokeColor="@color/budget_blue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <View
            android:layout_width="@dimen/space_8"
            android:layout_height="match_parent"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="12sp"
            android:id="@+id/fillPlanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/remainder_fill_plan"
            android:layout_weight="1"
            app:cornerRadius="@dimen/radius_10"
            app:strokeColor="@color/budget_blue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <View
            android:layout_width="@dimen/space_8"
            android:layout_height="match_parent"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="12sp"
            android:id="@+id/fillDefaultButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/remainder_fill_default"
            android:layout_weight="1"
            app:cornerRadius="@dimen/radius_10"
            app:strokeColor="@color/budget_blue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/distributeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:minHeight="@dimen/touch_min_size"
        android:text="@string/remainder_submit"
        app:backgroundTint="@color/income_green"
        app:cornerRadius="@dimen/radius_10"
        style="@style/Widget.MaterialComponents.Button"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"/>
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/emptyText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/remainder_empty"
        style="@style/Text.MyBudget.Subtitle"/>
</LinearLayout>
