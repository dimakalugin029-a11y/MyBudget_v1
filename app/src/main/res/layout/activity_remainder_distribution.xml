            <TextView android:id="@+id/sourceInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/transaction_hero_card_bg_income" android:gravity="center" android:padding="@dimen/space_16" android:text="@string/income_distribution_parent_fallback" android:textColor="@color/main_hero_text_primary" android:textSize="16sp" android:textStyle="bold" style="@style/Text.MyBudget.Section" />
        </androidx.cardview.widget.CardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_8" android:text="@string/remainder_pick_categories" style="@style/Text.MyBudget.SectionLabel" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/categoriesRecyclerView" android:paddingBottom="@dimen/space_8" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="0dp">
        <TextView android:id="@+id/totalAmountText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/transaction_hero_card_bg_income" android:gravity="center" android:padding="@dimen/space_16" android:text="@string/income_distribution_totals_default" android:textColor="@color/main_hero_text_primary" android:textSize="15sp" android:textStyle="bold" style="@style/Text.MyBudget.Section" />
    </androidx.cardview.widget.CardView>
    <LinearLayout android:orientation="vertical" android:id="@+id/fillButtonsGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8">
        <com.google.android.material.button.MaterialButton android:textSize="14sp" android:id="@+id/fillEqualButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min_size" android:text="@string/remainder_fill_equal" app:cornerRadius="@dimen/radius_12" app:strokeColor="@color/md_theme_primary" style="@style/Widget.MyBudget.Button.Outlined" />
        <View android:layout_width="match_parent" android:layout_height="@dimen/space_4" />
        <com.google.android.material.button.MaterialButton android:textSize="14sp" android:id="@+id/fillPlanButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min_size" android:text="@string/remainder_fill_plan" app:cornerRadius="@dimen/radius_12" app:strokeColor="@color/md_theme_primary" style="@style/Widget.MyBudget.Button.Outlined" />
        <View android:layout_width="match_parent" android:layout_height="@dimen/space_4" />
        <com.google.android.material.button.MaterialButton android:textSize="14sp" android:id="@+id/fillDefaultButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min_size" android:text="@string/remainder_fill_default" app:cornerRadius="@dimen/radius_12" app:strokeColor="@color/md_theme_primary" style="@style/Widget.MyBudget.Button.Outlined" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/distributeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:minHeight="@dimen/touch_min_size" android:text="@string/remainder_submit" app:cornerRadius="@dimen/radius_12" style="@style/Widget.MyBudget.Button" />
    <ProgressBar android:layout_gravity="center" android:id="@+id/progressBar" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" />
    <TextView android:textSize="16sp" android:gravity="center" android:id="@+id/emptyText" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="@string/remainder_empty" style="@style/Text.MyBudget.Subtitle" />
</LinearLayout>