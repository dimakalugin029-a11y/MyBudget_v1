<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_16">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        layout="@layout/include_screen_header"/>
    <TextView
        android:id="@+id/monthStartStepLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        style="@style/Text.MyBudget.SectionLabel"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_weight="1"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/main_hero_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/space_24">
            <TextView
                android:id="@+id/monthStartEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textSize="48sp" />
            <TextView
                android:id="@+id/monthStartTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:textColor="@color/main_hero_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                style="@style/Text.MyBudget.Section" />
            <TextView
                android:id="@+id/monthStartBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:textColor="@color/main_hero_text_secondary"
                android:textSize="15sp"
                style="@style/Text.MyBudget.Subtitle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monthStartActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:minHeight="@dimen/touch_min_size"
                android:textColor="@color/main_hero_text_primary"
                android:visibility="gone"
                app:cornerRadius="@dimen/radius_10"
                app:strokeColor="@color/main_hero_text_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/monthStartSkipButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/month_start_skip"
            android:layout_weight="1"
            app:cornerRadius="@dimen/radius_10"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/monthStartNextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min_size"
            android:text="@string/month_start_next"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            app:backgroundTint="@color/budget_blue"
            app:cornerRadius="@dimen/radius_10"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>
</LinearLayout>
