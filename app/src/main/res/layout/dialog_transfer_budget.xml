<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:id="@+id/transferBudgetInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.MyBudget.Subtitle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:id="@+id/transferFromFixedText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            style="@style/Text.MyBudget.Subtitle"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/transferFromPickersGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/budget_transfer_from"
                style="@style/Text.MyBudget.SectionLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/budget_transfer_budget_label"
                style="@style/Text.MyBudget.SectionLabel"/>
            <Spinner
                android:id="@+id/fromBudgetSpinner"
                android:padding="@dimen/space_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/budget_transfer_subcategory_label"
                style="@style/Text.MyBudget.SectionLabel"/>
            <Spinner
                android:id="@+id/fromSubcategorySpinner"
                android:padding="@dimen/space_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/budget_transfer_to"
            style="@style/Text.MyBudget.SectionLabel"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/budget_transfer_budget_label"
            style="@style/Text.MyBudget.SectionLabel"/>
        <Spinner
            android:id="@+id/toBudgetSpinner"
            android:padding="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/budget_transfer_subcategory_label"
            style="@style/Text.MyBudget.SectionLabel"/>
        <Spinner
            android:id="@+id/toSubcategorySpinner"
            android:padding="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"/>
        <TextView
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/budget_transfer_amount_label"
            style="@style/Text.MyBudget.SectionLabel"/>
        <EditText
            android:textColor="@color/text_primary"
            android:id="@+id/transferBudgetAmountInput"
            android:background="@drawable/edittext_border"
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"/>
    </LinearLayout>
</ScrollView>
