<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obligations_name_label"/>
        <EditText
            android:id="@+id/obligationNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:hint="@string/obligations_name_hint"
            android:inputType="textCapSentences"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obligations_amount_label"/>
        <EditText
            android:id="@+id/obligationAmountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:hint="0,00"
            android:inputType="numberDecimal"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obligations_period_label"/>
        <Spinner
            android:id="@+id/obligationPeriodSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/obligationDueMonthLabel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obligations_due_month_label"/>
        <Spinner
            android:id="@+id/obligationDueMonthSpinner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obligations_category_label"/>
        <Spinner
            android:id="@+id/obligationCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obligations_paychecks_label"/>
        <Spinner
            android:id="@+id/obligationPaychecksSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"/>
        <TextView
            android:textColor="@color/primary_green"
            android:id="@+id/obligationPreviewLine"
            android:paddingTop="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.MyBudget.Subtitle"/>
    </LinearLayout>
</ScrollView>
