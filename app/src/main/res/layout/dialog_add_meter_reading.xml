<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/meter_reading_date_label"
        style="@style/Text.MyBudget.Subtitle"/>
    <EditText
        android:textColor="@color/text_primary"
        android:id="@+id/readingDateInput"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_8"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:hint="@string/meter_reading_date_pick"
        android:cursorVisible="false"
        android:inputType="none"
        android:importantForAutofill="no"/>
    <EditText
        android:textColor="@color/text_primary"
        android:id="@+id/readingValueInput"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:hint="@string/meter_reading_value"
        android:inputType="numberDecimal"
        android:importantForAutofill="no"/>
    <EditText
        android:textColor="@color/text_primary"
        android:id="@+id/readingConsumptionInput"
        android:background="@drawable/edittext_border"
        android:padding="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:hint="@string/meter_reading_consumption"
        android:inputType="numberDecimal"
        android:importantForAutofill="no"/>
</LinearLayout>
